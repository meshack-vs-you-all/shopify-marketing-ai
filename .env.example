# ============================================
# Shopify Marketing AI - Root Environment
# ============================================
# This file documents all environment variables needed for Railway deployment
# Copy to .env and fill in your values (for local development)
# For Railway: Set these in the Railway dashboard under Variables
# NEVER commit actual secrets to git!

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=production
PORT=5000
API_URL=https://your-backend.railway.app
FRONTEND_URL=https://your-frontend.railway.app

# Database (Railway provides this automatically with Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (Railway provides this automatically with Redis plugin)
REDIS_URL=redis://host:6379

# API Authentication (REQUIRED - generate with: openssl rand -base64 32)
API_KEY=your-secure-api-key-change-this

# Shopify Integration (REQUIRED for Shopify features)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# Meta (Facebook/Instagram) Ads (REQUIRED for Meta Ads features)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_PAGE_ID=your_facebook_page_id

# Google Gemini AI (OPTIONAL - legacy provider)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter AI Gateway (RECOMMENDED - multi-model support)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
AI_PROVIDER=openrouter

# AWS SES Email (REQUIRED for email campaigns)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
SES_FROM_EMAIL=marketing@yourdomain.com

# Google Ads (OPTIONAL)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Klaviyo (OPTIONAL - alternative email platform)
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# Feature Flags
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_AUTO_APPROVAL=false
AUTO_APPROVAL_THRESHOLD=20

# Logging
LOG_LEVEL=info

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# Backend API URL (REQUIRED)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# App Configuration
NEXT_PUBLIC_APP_NAME=Shopify Marketing AI
NEXT_PUBLIC_APP_URL=https://your-frontend.railway.app

# Analytics (OPTIONAL)
NEXT_PUBLIC_GA_ID=
