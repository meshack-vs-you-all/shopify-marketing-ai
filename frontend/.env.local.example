# ============================================
# Shopify Marketing AI - Frontend Environment
# ============================================
# Copy this file to .env.local and fill in your values
# For Railway: Set these in the Railway dashboard under Variables
# NEVER commit .env.local to git!

# ============================================
# BACKEND API URL (REQUIRED)
# ============================================
# For local development: http://localhost:5000
# For Railway production: Use your backend service URL
# Example: https://shopify-marketing-ai-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME=Shopify Marketing AI
# NEXT_PUBLIC_APP_URL=https://your-frontend.railway.app

# ============================================
# API KEY (Optional - can be entered in UI)
# ============================================
# If set here, users won't need to enter it in the login form
# For production, it's recommended to let users enter their own API key
# NEXT_PUBLIC_API_KEY=your-api-key-here

# ============================================
# ANALYTICS (Optional)
# ============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
