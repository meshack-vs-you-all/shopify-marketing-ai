// Prisma Schema for Shopify Marketing Automation AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Campaigns
model Campaign {
  id            String   @id @default(cuid())
  type          CampaignType @default(META_AD) // NEWSLETTER or META_AD
  platform      Platform @default(META)
  name          String
  status        CampaignStatus @default(DRAFT)
  
  // -- Budget & Schedule --
  budget        Decimal? @db.Decimal(10, 2)
  dailyBudget   Decimal? @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?

  // -- Audience --
  emailListId   String?
  emailList     EmailList? @relation(fields: [emailListId], references: [id])
  targetAudience Json?   // Meta targeting params or generic

  // -- Content (Meta) --
  objective     String?
  headline      String?
  primaryText   String?
  description   String?
  cta           String?
  creativeUrl   String?
  previewImage  String?

  // -- Content (Email) --
  subject       String?
  htmlContent   String?  @db.Text
  textContent   String?  @db.Text
  
  // -- Meta/External --
  externalId    String?  // ID from platform (Meta/Google)
  
  // Performance metrics
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(10, 2)
  revenue       Decimal  @default(0) @db.Decimal(10, 2)
  roas          Decimal? @db.Decimal(5, 2) // Return on Ad Spend
  
  // Relations
  adSets        AdSet[]
  approvals     Approval[]
  metrics       CampaignMetric[]
  deliveryLogs  EmailDeliveryLog[] // Direct relation for Newsletter sends
  
  // Counts for local tracking
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)

  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([type, status])
  @@index([platform, status])
  @@index([externalId])
  @@map("campaigns")
}

enum CampaignType {
  NEWSLETTER
  META_AD
}


// Ad Sets (Meta) / Ad Groups (Google)
model AdSet {
  id            String   @id @default(cuid())
  campaignId    String
  name          String
  status        CampaignStatus @default(DRAFT)
  budget        Decimal  @db.Decimal(10, 2)
  bidStrategy   String?
  targeting     Json?    // Targeting parameters
  externalId    String?
  
  // Relations
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads           Ad[]
  metrics       AdSetMetric[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([campaignId])
  @@index([externalId])
  @@map("ad_sets")
}

// Individual Ads
model Ad {
  id            String   @id @default(cuid())
  adSetId       String
  name          String
  status        CampaignStatus @default(DRAFT)
  creativeType  CreativeType
  headline      String?
  description   String?
  primaryText   String?
  callToAction  String?
  imageUrl      String?
  videoUrl      String?
  landingPageUrl String?
  externalId    String?
  
  // AI Generation metadata
  aiGenerated   Boolean  @default(false)
  aiModel       String?  // e.g., "gpt-4"
  aiPrompt      String?
  humanReviewed Boolean  @default(false)
  
  // Performance
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(10, 2)
  ctr           Decimal? @db.Decimal(5, 4) // Click-through rate
  cpc           Decimal? @db.Decimal(10, 2) // Cost per click
  
  // Relations
  adSet         AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  metrics       AdMetric[]
  abTests       ABTest[] @relation("TestAds")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([adSetId])
  @@index([status])
  @@index([externalId])
  @@map("ads")
}

// Performance Metrics (time-series data)
model CampaignMetric {
  id            String   @id @default(cuid())
  campaignId    String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(10, 2)
  revenue       Decimal  @default(0) @db.Decimal(10, 2)
  
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([campaignId, date])
  @@index([campaignId, date])
  @@map("campaign_metrics")
}

model AdSetMetric {
  id            String   @id @default(cuid())
  adSetId       String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(10, 2)
  revenue       Decimal  @default(0) @db.Decimal(10, 2)
  
  adSet         AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([adSetId, date])
  @@index([adSetId, date])
  @@map("ad_set_metrics")
}

model AdMetric {
  id            String   @id @default(cuid())
  adId          String
  date          DateTime @db.Date
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spend         Decimal  @default(0) @db.Decimal(10, 2)
  revenue       Decimal  @default(0) @db.Decimal(10, 2)
  
  ad            Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([adId, date])
  @@index([adId, date])
  @@map("ad_metrics")
}

// Approval Workflows
model Approval {
  id            String   @id @default(cuid())
  type         ApprovalType
  status        ApprovalStatus @default(PENDING)
  entityType    String   // "campaign", "ad", "budget_change", etc.
  entityId      String
  campaignId    String?
  
  // Request details
  requestedBy   String?  // User/system identifier
  requestedAt   DateTime @default(now())
  requestData   Json     // Details of what needs approval
  
  // Approval details
  approvedBy    String?
  approvedAt    DateTime?
  rejectedBy    String?
  rejectedAt    DateTime?
  rejectionReason String?
  
  // Relations
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([status])
  @@index([type])
  @@index([campaignId])
  @@map("approvals")
}

// A/B Tests
model ABTest {
  id            String   @id @default(cuid())
  name          String
  status        ABTestStatus @default(RUNNING)
  startDate     DateTime
  endDate       DateTime?
  trafficSplit  Int      @default(50) // Percentage for variant A
  
  // Results
  variantAWinner Boolean?
  confidence     Decimal? @db.Decimal(5, 4) // Statistical confidence
  notes          String?
  
  // Relations
  ads           Ad[]     @relation("TestAds")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("ab_tests")
}

// Automation Rules
model AutomationRule {
  id            String   @id @default(cuid())
  name          String
  enabled       Boolean  @default(true)
  triggerType   TriggerType
  conditions    Json     // Conditions that trigger the rule
  actions       Json     // Actions to take when triggered
  priority      Int      @default(0)
  
  // Execution tracking
  lastTriggered DateTime?
  triggerCount  Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("automation_rules")
}

// Generated Content (AI)
model GeneratedContent {
  id            String   @id @default(cuid())
  type          ContentType
  platform      Platform?
  prompt        String
  model         String   // AI model used
  content       String   // Generated content
  metadata      Json?    // Additional metadata
  status        ContentStatus @default(DRAFT)
  
  // Usage tracking
  usedInAdId    String?
  usedInEmailId String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([type])

  @@map("generated_content")
}

// Email Lists
model EmailList {
  id          String   @id @default(cuid())
  name        String
  description String?
  externalId  String?  // Klaviyo List ID
  subscribers Subscriber[]
  campaigns     EmailCampaign[]
  unifiedCampaigns Campaign[] // Relation to new generic Campaign model

  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_lists")
}

// Subscribers
model Subscriber {
  id          String   @id @default(cuid())
  email       String
  firstName   String?
  lastName    String?
  status      SubscriberStatus @default(SUBSCRIBED)
  listId      String
  importSource String?  // "manual", "csv", "api", "shopify"

  // Relations
  list        EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  deliveryLogs EmailDeliveryLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, listId])
  @@index([listId])
  @@map("subscribers")
}

// Email Campaigns
model EmailCampaign {
  id            String   @id @default(cuid())
  name          String
  status        CampaignStatus @default(DRAFT)
  subject       String
  htmlContent   String?  @db.Text
  textContent   String?  @db.Text

  listId        String
  scheduledAt   DateTime?
  sentAt        DateTime?
  
  // Relations
  emailList     EmailList @relation(fields: [listId], references: [id])
  deliveryLogs  EmailDeliveryLog[]

  // Performance
  sentCount     Int      @default(0)
  deliveredCount Int     @default(0)
  openCount     Int      @default(0)
  clickCount    Int      @default(0)
  failedCount   Int      @default(0)
  
  // AI Generation
  aiGenerated   Boolean  @default(false)
  generatedContentId String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("email_campaigns")
}

// Email Delivery Logs
model EmailDeliveryLog {
  id            String   @id @default(cuid())
  campaignId    String
  subscriberId  String
  status        DeliveryStatus
  messageId     String?
  errorMessage  String?
  sentAt        DateTime @default(now())
  openedAt      DateTime?
  clickedAt     DateTime?

  // Relations
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailCampaign EmailCampaign? @relation(fields: [emailCampaignId], references: [id])
  emailCampaignId String?      // Temporarily keep ensuring backwards compat if needed, or just switch
  subscriber    Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([emailCampaignId])
  @@index([subscriberId])
  @@map("email_delivery_logs")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  OPENED
  CLICKED
}

// Audit Log
model AuditLog {
  id            String   @id @default(cuid())
  action        String
  entityType    String
  entityId      String?
  userId        String?
  changes       Json?    // Before/after changes
  metadata      Json?
  
  createdAt     DateTime @default(now())
  
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Enums
enum Platform {
  META
  GOOGLE_ADS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  PENDING
  SCHEDULED
  SENDING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  DELETED
  FAILED
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  COLLECTION
}

enum ApprovalType {
  CAMPAIGN_CREATION
  BUDGET_INCREASE
  BUDGET_DECREASE
  CAMPAIGN_PAUSE
  CAMPAIGN_DELETE
  AD_CREATION
  CONTENT_GENERATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ABTestStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

enum TriggerType {
  PERFORMANCE_THRESHOLD
  BUDGET_LIMIT
  TIME_BASED
  MANUAL
}

enum ContentType {
  AD_COPY
  PRODUCT_DESCRIPTION
  EMAIL_SUBJECT
  EMAIL_BODY
  SOCIAL_POST
}

enum ContentStatus {
  DRAFT
  GENERATED
  REVIEWED
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}


// ... (Auth)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  googleId      String?   @unique
  avatar        String?
  role          UserRole  @default(ADMIN)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         BlogPost[]

  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// AI Settings for multi-model configuration
model AISettings {
  id                 String   @id @default("default")
  
  // Global defaults
  defaultModel       String   @default("anthropic/claude-3.5-sonnet")
  defaultTemperature Float    @default(0.7)
  defaultMaxTokens   Int      @default(2048)
  
  // Cost limits
  dailyBudgetLimit   Decimal  @default(50) @db.Decimal(10, 2)
  monthlyBudgetLimit Decimal  @default(500) @db.Decimal(10, 2)
  perRequestLimit    Decimal  @default(1) @db.Decimal(10, 2)
  
  // Per-task overrides (JSON structure)
  taskOverrides      Json     @default("{}")
  
  // Enabled models whitelist
  enabledModels      String[] @default([])
  
  // Feature flags
  enableFallbacks    Boolean  @default(true)
  enableCostTracking Boolean  @default(true)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("ai_settings")
}

// AI Usage Log for cost tracking
model AIUsageLog {
  id               String   @id @default(cuid())
  model            String
  taskType         String
  promptTokens     Int
  completionTokens Int
  cost             Decimal  @db.Decimal(10, 6)
  timestamp        DateTime @default(now())
  
  // Optional request tracking
  requestId        String?
  userId           String?
  
  @@index([timestamp])
  @@index([model])
  @@index([taskType])
  @@map("ai_usage_logs")
}

// Prompt Template for consistency
model PromptTemplate {
  id        String   @id @default(cuid())
  name      String
  version   String   @default("1.0.0")
  template  String   @db.Text
  taskType  String
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([name, version])
  @@index([taskType, isActive])
  @@map("prompt_templates")
}

// Blog Posts
model BlogPost {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String?     @db.Text
  content     String      @db.Text // Markdown or HTML
  coverImage  String?
  published   Boolean     @default(false)
  publishedAt DateTime?
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  
  // SEO Metadata
  seoTitle    String?
  seoDesc     String?
  keywords    String[]

  // Shopify Integration
  featuredProductId String? // Stores Shopify Product ID or Handle

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([published, publishedAt])
  @@map("blog_posts")
}

// ============================================
// META PUBLISHING (Instagram, Facebook, WhatsApp)
// ============================================

// Meta connected accounts (pages, IG accounts)
model MetaAccount {
  id              String          @id @default(cuid())
  type            MetaAccountType
  externalId      String          // Meta's account ID
  name            String
  accessToken     String          // Page/account token (should be encrypted in prod)
  tokenExpiresAt  DateTime?
  metadata        Json?           // Profile pic URL, follower count, etc.
  isActive        Boolean         @default(true)
  
  posts           MetaPost[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@unique([type, externalId])
  @@index([isActive])
  @@map("meta_accounts")
}

enum MetaAccountType {
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
  WHATSAPP_BUSINESS
}

// Scheduled/published posts to Meta platforms
model MetaPost {
  id              String          @id @default(cuid())
  accountId       String
  account         MetaAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // Content
  caption         String          @db.Text
  mediaUrls       String[]        // Array of media URLs
  mediaType       MetaMediaType   @default(IMAGE)
  
  // AI Generation metadata
  aiGenerated     Boolean         @default(false)
  aiModel         String?
  aiPromptHints   Json?           // { tone, length, productId, etc. }
  
  // Scheduling
  status          MetaPostStatus  @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  
  // Meta response
  externalId      String?         // Published post ID from Meta
  containerIds    String[]        // For Instagram container workflow
  
  // Tracking
  campaignId      String?
  idempotencyKey  String?         @unique
  
  // Error handling
  lastError       String?
  retryCount      Int             @default(0)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([accountId, status])
  @@index([scheduledAt])
  @@index([status])
  @@map("meta_posts")
}

enum MetaMediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
}

enum MetaPostStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
